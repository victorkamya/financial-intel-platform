# AWS — primary (us-west-2) and DR (us-east-1) both use these same keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only if using temporary/SSO creds

# Databricks — existing us-west-2 workspace + its service principal (overarching-sp)
DATABRICKS_HOST=https://<your-workspace-id>.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
UC_TRUST_ACCOUNT_ID=
DATABRICKS_METASTORE_ID=
